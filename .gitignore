# Visual Studio 2015 user specific files
.vs/

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Fortran module files
*.mod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app
*.ipa

# These project files can be generated by the engine
*.xcodeproj
*.xcworkspace
*.sln
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb

# Precompiled Assets
SourceArt/**/*.png
SourceArt/**/*.tga

# Binary Files
Binaries/*
Plugins/**/Binaries/*

# Builds
Build/*

# Whitelist PakBlacklist-<BuildConfiguration>.txt files
!Build/*/
Build/*/**
!Build/*/PakBlacklist*.txt

# Don't ignore icon files in Build
!Build/**/*.ico

# Built data for maps
*_BuiltData.uasset

# Configuration files generated by the Editor
Saved/*

# Compiled source files for the engine to use
Intermediate/*
Plugins/**/Intermediate/*

# Cache files for the editor to use
DerivedDataCache/*

# Global Excludes for All Projects
**/Intermediate/
**/Saved/
**/Binaries/
**/DerivedDataCache/
**/.vs/
**/.vscode/
**/*.VC.db
**/*.sdf
**/*.opensdf
**/*.suo
**/*.log
**/*.tmp
**/*.user
**/node_modules/
**/build/
**/__pycache__/
**/*.pyc

# Exclude Solution Files
*.sln

# MacOS/Linux Metadata
.DS_Store
Thumbs.db

# Only track essential Config
!**/Config/
!**/Config/Default*.ini

# Allow Source and Content
!**/Source/
!**/Content/
clean_project.bat
